parameters:
- name: imageName               # Name of the Docker image
  default: 'backend-auth-app'
- name: imageTag
  default: '$(Build.BuildNumber)'
- name: registryName            # Name of Azure Container Registry
  default: az21devdrstacr01
- name: serviceConnection       # Azure service connection
  default: 'KCL-company-Nonprod'
- name: appServiceName
  default: 'az21ldrstauthwebappd01'
- name: appServiceResourceGroup
  default: 'project-NonProd-company-CCT-Dev-RG'
- name: ENV
  default: dev

stages:
- stage: Deploy
  displayName: 'Deploy to ${{ parameters.ENV }}'
  condition: 
    or(
      and(eq('${{ parameters.ENV }}', 'NonProd'), 
          or(eq(variables['Build.SourceBranch'], 'refs/heads/qa'), startsWith(variables['Build.SourceBranch'], 'refs/heads/hotfix/'))),
      and(eq('${{ parameters.ENV }}', 'Prod'), eq(variables['Build.SourceBranch'], 'refs/heads/main')),
      eq('${{ parameters.ENV }}', 'Dev')
    )

  jobs:
  - deployment: DeployKPIApp
    displayName: 'Deploy Auth web app to ${{ parameters.ENV }}'
    environment: '${{ parameters.ENV }}'
    workspace:
      clean: all
    strategy:
      runOnce:
        deploy:
          steps:
          - checkout: self
            env:
              HTTP_PROXY: http://cloudproxy.adani.com:8080
              HTTPS_PROXY: http://cloudproxy.adani.com:8080

          - task: AzureCLI@2
            displayName: Replace Token in .npmrc
            inputs:
              azureSubscription: ${{ parameters.serviceConnection }}
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                set -e
                
                # Try fetching the secret
                if ! GITHUB_TOKEN=$(az keyvault secret show --name github-artifact-pat-token --vault-name $(keyVaultName) --query value -o tsv); then
                  echo "Error: Failed to retrieve the secret 'github-artifact-pat-token' from Key Vault '$(keyVaultName)'."
                  exit 1
                fi
                
                # Export the secret as a pipeline variable
                echo "##vso[task.setvariable variable=GITHUB_TOKEN]$GITHUB_TOKEN"
      
                # Replace the literal ${GITHUB_TOKEN} with the actual token
                sed -i 's|\${GITHUB_TOKEN}|'$GITHUB_TOKEN'|g' $(Build.SourcesDirectory)/company-auth-ms/.npmrc       
                echo "Token replacement complete."
      
          - task: AzureCLI@2
            displayName: 'ACR Docker Login using Admin Credentials'
            inputs:
              azureSubscription: ${{ parameters.serviceConnection }}
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                ACCESS_TOKEN=$(az acr login --name ${{ parameters.registryName }} --expose-token --output tsv --query accessToken)
                echo "##vso[task.setvariable variable=USERNAME]00000000-0000-0000-0000-000000000000"
                echo "##vso[task.setvariable variable=PASSWORD]$ACCESS_TOKEN"
                    
      
          - task: AzureCLI@2
            enabled: true
            displayName: 'Build and Push Docker Image'
            inputs:
              azureSubscription: ${{ parameters.serviceConnection }}
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                sudo mkdir -p /etc/systemd/system/docker.service.d
                export NO_PROXY="localhost,127.0.0.1,${{ parameters.registryName }}.azurecr.io"
                echo "[Service]
                Environment=\"HTTP_PROXY=http://cloudproxy.adani.com:8080\"
                Environment=\"HTTPS_PROXY=http://cloudproxy.adani.com:8080\"
                Environment=\"NO_PROXY=$NO_PROXY\"" | sudo tee /etc/systemd/system/docker.service.d/http-proxy.conf
                sudo systemctl daemon-reload
                sudo -E systemctl restart docker
                sudo docker login ${{ parameters.registryName }}.azurecr.io --username $USERNAME --password $PASSWORD
                sudo cp -R /etc/pki/ca-trust/source/anchors/rootca.pem $(System.DefaultWorkingDirectory)/company-auth-ms/rootca.pem
                sudo docker build --no-cache -t ${{ parameters.registryName }}.azurecr.io/${{ parameters.imageName }}:${{ parameters.imageTag }} $(System.DefaultWorkingDirectory)/company-auth-ms/
                sudo docker push ${{ parameters.registryName }}.azurecr.io/${{ parameters.imageName }}:${{ parameters.imageTag }}
      
          - task: AzureCLI@2
            enabled: true
            displayName: 'Update Azure App Service with New Docker Image'
            inputs:
              azureSubscription: ${{ parameters.serviceConnection }}
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az webapp config set -g ${{ parameters.appServiceResourceGroup}} -n ${{ parameters.appServiceName }} \
                  --generic-configurations '{"acrUseManagedIdentityCreds": true}'
                az webapp config container set \
                  --name ${{ parameters.appServiceName }} \
                  --resource-group ${{ parameters.appServiceResourceGroup}} \
                  --docker-custom-image-name ${{ parameters.registryName }}.azurecr.io/${{ parameters.imageName }}:${{ parameters.imageTag }} 
      
          - task: replacetokens@6
            enabled: true
            displayName: Replace Token in app-setting.json
            inputs:
              sources: '$(System.DefaultWorkingDirectory)/company-auth-ms/app-setting.json'
              tokenPattern: 'custom'
              tokenPrefix: '__'
              tokenSuffix: '__'
              ifNoFilesFound: 'warn'
              
          - task: AzureCLI@2
            enabled: true
            displayName: 'Update App settings'
            inputs:
              azureSubscription: ${{ parameters.serviceConnection }}
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
               az webapp config appsettings set -g ${{ parameters.appServiceResourceGroup}} -n ${{ parameters.appServiceName }} \
                 --settings "@$(System.DefaultWorkingDirectory)/company-auth-ms/app-setting.json"
